{
  "name": "float-file",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable --x64",
    "dist:nosign": "vite build && electron-builder --win portable --x64 -c.win.signAndEditExecutable=false",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "productName": "FLOAT.FILE",
  "description": "FLOAT.FILE",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.floatfile.app",
    "productName": "FLOAT.FILE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "FLOAT.FILE"
    },
    "portable": {
      "artifactName": "FLOAT.FILE.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false
  }
}
